---
import PageLayout from "@/layouts/PageLayout.astro";
import { getAllTagArchives } from "@/utils/content";
import { getAssetPath } from "@/utils/url";
import { titleify, getTagTransitionName } from "@/utils/text";

const tagArchives = await getAllTagArchives();
---

<PageLayout
  title="Tags"
  description="Browse posts by tag."
>
  {
    tagArchives.length > 0 ? (
      <ul class="grid gap-x-16 sm:grid-cols-2">
        {tagArchives.map((archive) => (
          <li>
            <a
              href={getAssetPath(`tags/${archive.slug}`)}
              class="group flex min-h-11 items-baseline justify-between gap-3 py-1.5 sm:min-h-0 sm:py-1"
            >
              <span 
                class="min-w-0 wrap-anywhere link-underline group-hover:text-primary font-content text-xl transition-colors"
                transition:name={getTagTransitionName(archive.tag)}
              >
                {titleify(archive.tag)}
              </span>

              <span class="text-muted-foreground shrink-0 text-sm font-ui uppercase tabular-nums">
                {archive.count} {archive.count === 1 ? "post" : "posts"}
              </span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="text-muted-foreground">
        No tags have been published yet.
      </p>
    )
  }
</PageLayout>
