---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SEO from "@/components/SEO.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import { type Page, type Post } from "@/utils/content";
import { formatDate } from "@/utils/date";

interface Props {
  entry?: Page | Post;
  title?: string;
  description?: string;
  showBreadcrumb?: boolean;
  transitionName?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  showHeader?: boolean;
}

const {
  entry,
  title: propTitle,
  description: propDescription,
  showBreadcrumb = true,
  transitionName,
  noindex = false,
  schema,
  showHeader = true,
} = Astro.props;

const {
  title: entryTitle,
  description: entryDescription,
  published,
  updated,
} = entry?.data ?? {};

const title =
  propTitle ??
  entryTitle;

const description =
  propDescription ??
  entryDescription;

const last = updated ? updated : published;
const searchable = Boolean(entry && !entry.data.draft && !noindex);

const dateLocale = entry?.data.lang ?? "en";
const formattedDate = last ? formatDate(last, dateLocale, "long") : undefined;

---
<BaseLayout schema={schema} lang={entry?.data.lang}>
  <SEO
    slot="seo"
    title={title}
    description={description ?? ""}
    {noindex}
  />
  <Fragment slot="header">
    {showBreadcrumb && <Breadcrumb />}

    {
      showHeader &&
      <PageHeader {title} subheading={description} transitionName={transitionName} {searchable}>
      {last && (
        <span slot="meta">
          Updated <time datetime={last.toISOString()} lang={dateLocale}>{formattedDate}</time>
        </span>
      )}
    </PageHeader>
    }
  </Fragment>
  <section data-pagefind-body={searchable || undefined}>
    {searchable && !showHeader && <meta data-pagefind-meta="title[content]" content={title} />}
    <slot />
  </section>
</BaseLayout>
