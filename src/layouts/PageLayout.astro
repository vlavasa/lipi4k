---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHeader from "@/components/PageHeader.astro";
import SEO from "@/components/SEO.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Footer from "@/components/Footer.astro";
import siteConfig from "@/site.config";
import { type Page, type Post } from "@/utils/content";

interface Props {
  entry?: Page | Post;
  title?: string;
  description?: string;
  showBreadcrumb?: boolean;
  transitionName?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>;
  showHeader?: boolean;
}

const {
  entry,
  title: propTitle,
  description: propDescription,
  showBreadcrumb = true,
  transitionName,
  noindex = false,
  schema,
  showHeader = true,
} = Astro.props;

// Pages: entry annotation takes precedence over the global fallback.
const footerAnnotation = entry?.data.annotation ?? siteConfig.annotation;

const {
  title: entryTitle,
  description: entryDescription,
  published,
  updated,
} = entry?.data ?? {};

const title =
  propTitle ??
  entryTitle;

const description =
  propDescription ??
  entryDescription;

const last = updated ? updated : published;
const searchable = Boolean(entry && !entry.data.draft && !noindex);

const formattedDate = last?.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
});

---
<BaseLayout schema={schema} lang={entry?.data.lang}>
  <SEO
    slot="seo"
    title={title}
    description={description ?? ""}
    {noindex}
  />
  <Fragment slot="header">
    {showBreadcrumb && <Breadcrumb />}

    {
      showHeader &&
      <PageHeader {title} subheading={description} transitionName={transitionName} {searchable}>
      {formattedDate && (
        <span slot="meta">Updated {formattedDate}</span>
      )}
    </PageHeader>
    }
  </Fragment>
  <section data-pagefind-body={searchable || undefined}>
    {searchable && !showHeader && <meta data-pagefind-meta="title[content]" content={title} />}
    <slot />
  </section>
  <Fragment slot="footer">
    <Footer annotation={footerAnnotation} />
  </Fragment>
</BaseLayout>
