---
import siteConfig from "@/site.config";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { type Post, getPostUrl, getAllPosts, getRelatedPosts } from "@/utils/content";
import { slugify } from "@/utils/text";
import { getCoverImage, getGalleryImages } from "@/utils/image";
import Breadcrumb from "@/components/Breadcrumb.astro";
import ReadingProgress from "@/components/ReadingProgress.astro";
import SEO from "@/components/SEO.astro";
import PostNavigation from "@/components/content/PostNavigation.astro";
import { generatePostSchema } from "@/utils/schema";
import PostMeta from "@/components/content/PostMeta.astro";
import RelatedPosts from "@/components/content/RelatedPosts.astro";
import ImageWrapper from "@/components/ImageWrapper.astro";
import PostGallery from "@/components/content/PostGallery.astro";
import type { MarkdownHeading } from "astro";
import { getArticleContents } from "@/utils/contents";

type Props = {
  post: Post;
  prevPost?: Post | null;
  nextPost?: Post | null;
  headings?: MarkdownHeading[];
};

const {
  post,
  prevPost,
  nextPost,
  headings = [],
} = Astro.props;

const { title, description, cover, published, tags } = post.data;
const annotation = post.data.annotation?.trim();

const allPosts    = await getAllPosts();
const relatedPosts = getRelatedPosts(post, allPosts, siteConfig.relatedPosts);
const ogImage = `${getPostUrl(post.id, post.filePath)}/index.png`;
const structuredData = generatePostSchema(post);
const coverImage = getCoverImage(cover);
const galleryImages = getGalleryImages(post.filePath ?? '');
const contents = getArticleContents(headings, post.data.lang, siteConfig.tableOfContentsLabels);
---

<BaseLayout schema={structuredData} lang={post.data.lang} {contents}>
  <SEO
    slot="seo"
    {title}
    description={description ?? ""}
    type="article"
    publishedTime={published}
    {tags}
    {ogImage}
  />
  <Fragment slot="header">
    <Breadcrumb />
    <!-- Post Header -->
    <header class="space-y-4">
      <!-- Title -->
      <h1 
          data-pagefind-body
          data-pagefind-meta="title"
          class="text-3xl leading-tight tracking-tight font-medium md:text-4xl mb-2 text-balance"
          transition:name={slugify(post.data.title.replaceAll(".", "-"))}
      >
          {post.data.title}
      </h1>

      <!-- Description -->
      {
        post.data.description && (
          <p data-pagefind-body class="max-w-xl text-base text-prettyfont-content italic font-light leading-relaxed text-muted-foreground">
            {post.data.description}
          </p>
        )
      }
      
      <!-- Metadata -->
      <PostMeta post={post} class="mb-3" />
      <div class="divider" />
    </header>
  </Fragment>

  <section>
    <!-- Cover -->
    {coverImage && (
      <section class="breakout overflow-hidden rounded-sm ring ring-border shadow-sm">
        <ImageWrapper src={coverImage} alt={title} class="block w-full h-auto" fetchPriority="high" />
      </section>
    )}

    <!-- Post Content -->
    <article data-pagefind-body class="post-content flex flex-col space-y-2">
      <!-- Rendered markdown -->
	    <div class="app-prose post-content" data-contents-article>
	      <slot />
	    </div>
      <!-- Gallery -->
      {galleryImages.length > 0 && (
        <PostGallery images={galleryImages} galleryId={post.id} />
      )}
	  </article>

    {/* Post annotation — document-level context, posts only, no footer fallback */}
    {annotation ? (
      <span class="font-annotation block text-primary max-w-70 md:max-w-80 mx-auto mt-4 text-center text-xl md:text-2xl -rotate-1 leading-snug">
        {annotation}
      </span>
    ) : (
      <hr class="article-divider" />
    )}

  </section>
  
  <Fragment slot="navigation">
    <PostNavigation
      prevPost={prevPost}
      nextPost={nextPost}
    />
  </Fragment>
  <Fragment slot="after">
    {relatedPosts.length > 0 && (
      <RelatedPosts posts={relatedPosts} sectionTitle="More like this"/>
    )}
  </Fragment>
  <Fragment slot="scripts">
    <ReadingProgress />
    <script>
      import "@/scripts/gallery";
    </script>
  </Fragment>

</BaseLayout>
