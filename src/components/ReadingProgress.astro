---

<div class="reading-progress-bar" aria-hidden="true"></div>

<script>
  let cleanup: (() => void) | undefined;

  function destroyReadingProgress() {
    cleanup?.();
    cleanup = undefined;
  }

  function initReadingProgress() {
    destroyReadingProgress();

    if (CSS.supports("animation-timeline: scroll()")) return;

    const bar = document.querySelector<HTMLElement>(".reading-progress-bar");
    if (!bar) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;

    function updateProgress() {
      frame = 0;
      const root = document.documentElement;
      const scrollRange = root.scrollHeight - root.clientHeight;
      const progress =
        reducedMotion.matches || scrollRange <= 0
          ? 0
          : Math.min(1, Math.max(0, window.scrollY / scrollRange));

      bar.style.setProperty("--reading-progress", String(progress));
    }

    function scheduleUpdate() {
      if (!frame) frame = requestAnimationFrame(updateProgress);
    }

    // Images and fonts can change the scroll range after the page loads.
    const observer = new ResizeObserver(scheduleUpdate);
    observer.observe(document.documentElement);
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
    window.addEventListener("pageshow", scheduleUpdate);
    reducedMotion.addEventListener("change", scheduleUpdate);
    scheduleUpdate();

    cleanup = () => {
      cancelAnimationFrame(frame);
      observer.disconnect();
      window.removeEventListener("scroll", scheduleUpdate);
      window.removeEventListener("resize", scheduleUpdate);
      window.removeEventListener("pageshow", scheduleUpdate);
      reducedMotion.removeEventListener("change", scheduleUpdate);
      bar.style.removeProperty("--reading-progress");
    };
  }

  document.addEventListener("astro:page-load", initReadingProgress);
  document.addEventListener("astro:before-swap", destroyReadingProgress);
</script>

<style>
  .reading-progress-bar {
    position: fixed;
    top: 0;
    left: 0;
    width: 2px;
    height: 100%;
    transform-origin: top center;
    transform: scaleY(var(--reading-progress, 0));
    background: color-mix(in srgb, var(--color-primary) 70%, transparent);
    z-index: 50;
    pointer-events: none;
  }

  @supports (animation-timeline: scroll()) {
    .reading-progress-bar {
      animation: reading-progress-y 1ms linear both;
      /* Keep the minifier from folding the timeline into the animation shorthand. */
      animation-timeline: scroll() !important;
      animation-range: 0 100%;
    }
  }

  @keyframes reading-progress-y {
    from {
      transform: scaleY(0);
    }
    to {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .reading-progress-bar {
      animation: none;
      transform: scaleY(0);
    }
  }
</style>
