---
interface Props {
  title?: string;
  subheading?: string;
  transitionName?: string;
  searchable?: boolean;
}
const { title, subheading, transitionName, searchable = false } = Astro.props;
---
<section class="flex flex-col mb-2">
  {title && (
    <h1 
      data-pagefind-body={searchable || undefined}
      data-pagefind-meta={searchable ? "title" : undefined}
      class="font-content text-3xl leading-tight font-medium md:text-4xl"
      transition:name={transitionName}
    > 
      {title} 
    </h1>
  )}
  {subheading && (
    <p data-pagefind-body={searchable || undefined} class="mt-2 max-w-xl text-base leading-relaxed italic text-muted-foreground">
      {subheading}
    </p>
  )}
  <div class="metadata mt-2">
    <slot name="meta" />
  </div>
  <div class="divider mb-8" />
</section>
