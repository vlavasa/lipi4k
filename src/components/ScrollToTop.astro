---
import ChevronUp from "@/assets/chevron-up.svg"
---
<button
  id="scroll-to-top" class="scroll-to-top"
  type="button"
  aria-label="Scroll to top"
  hidden
>
  <ChevronUp class="size-5 text-muted-foreground" />
</button>

<script>
  let cleanup: (() => void) | undefined;

  function destroyScrollToTop() {
    cleanup?.();
    cleanup = undefined;
  }

  function initScrollToTop() {
    destroyScrollToTop();

    const btn = document.getElementById('scroll-to-top');
    if (!btn) return;

    // Use IntersectionObserver on a sentinel at page top.
    const sentinel = document.createElement('div');
    sentinel.style.cssText = 'position:absolute;top:0;left:0;height:1px;width:1px;pointer-events:none;';
    document.body.prepend(sentinel);

    const observer = new IntersectionObserver(
      ([entry]) => {
        btn.hidden = entry.isIntersecting;
      },
      { threshold: 0, rootMargin: '400px 0px 0px 0px' }
    );

    observer.observe(sentinel);

    function scrollToTop() {
      // Inherit CSS scroll behavior, including the reduced-motion preference.
      window.scrollTo({ top: 0, behavior: 'auto' });
    }

    btn.addEventListener('click', scrollToTop);

    cleanup = () => {
      observer.disconnect();
      sentinel.remove();
      btn.removeEventListener('click', scrollToTop);
    };
  }

  document.addEventListener('astro:page-load', initScrollToTop);
  document.addEventListener('astro:before-swap', destroyScrollToTop);
</script>
