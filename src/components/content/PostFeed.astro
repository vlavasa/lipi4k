---
// PostFeed.astro
import { type Post } from "@/utils/content";
import SectionHeader from "@/components/SectionHeader.astro";
import PostPreview from "./PostPreview.astro";

type Props = {
  posts: Post[];
  sectionTitle?: string;
  sectionDesc?: string;
};

const {
  posts,
  sectionTitle,
  sectionDesc,
} = Astro.props;

// Group posts by year, preserving descending order within each group
const postsByYear = posts.reduce<Record<number, Post[]>>((acc, post) => {
  const year = (post.data.updated ?? post.data.published).getFullYear();
  acc[year] ??= [];
  acc[year].push(post);
  return acc;
}, {});

// Years descending
const years = Object.keys(postsByYear)
  .map(Number)
  .sort((a, b) => b - a);
---

<section>
  {
    sectionTitle && <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  }
  
  {years.map((year) => {
    const yearPosts = postsByYear[year];

    return (
      <div class="mb-6 last:mb-0">

        {/* Year header */}
        <div class="flex items-baseline justify-between py-2 mb-4 border-border/50 border-b font-ui text-sm uppercase tabular-nums text-muted-foreground">
          <span>
            {year}
          </span>
          <span>
            {yearPosts.length} {yearPosts.length === 1 ? "post" : "posts"}
          </span>
        </div>

        {/* Posts in this year */}
        {yearPosts.map((post) => (
          <PostPreview post={post} />
        ))}

      </div>
    );
  })}
</section>
