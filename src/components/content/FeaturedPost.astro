---
import type { Post } from "@/utils/content";
import PostTitle from "./PostTitle.astro";
import PostMeta from "@/components/content/PostMeta.astro";
import SectionHeader from "@/components/SectionHeader.astro";

type Props = {
  post: Post;
};

const { post } = Astro.props;
const { description } = post.data;

const sectionTitle = "Featured"
---

<section class="pt-4">

  <SectionHeader title={sectionTitle} />
  <article class="featured-post flex flex-col gap-2 md:max-w-xl">
    <PostTitle post={post}
      class="text-2xl md:text-3xl font-medium mt-0 text-balance" />

    {description && (
      <p class="text-sm italic leading-normal text-muted-foreground md:max-w-xl">
        {description}
      </p>
    )}

    <PostMeta post={post} />
  </article>
</section>
