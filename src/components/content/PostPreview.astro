---
import { type Post } from "@/utils/content";
import PostTitle from "./PostTitle.astro";
import PostMeta from "./PostMeta.astro";

type Props = {
  post: Post;
  class?: string;
  titleClass?: string;
};

const {
  post,
  class: className,
  titleClass = "text-lg",
} = Astro.props;
---

<div class:list={[
  "flex flex-col space-y-3 py-4 group hover:translate-x-2 transition-transform ease-fluid",
  className,
]}>
  <PostTitle
    post={post}
    class={`${titleClass} md:text-xl font-medium text-balance leading-snug link-hover`}
  />
  {post.data.description && (
    <p class="text-sm italic leading-normal text-muted-foreground md:max-w-xl">
      {post.data.description}
    </p>
  )}
  <PostMeta post={post} accentCategory showReadingTime />
</div>
