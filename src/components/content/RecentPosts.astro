---
import { type Post } from "@/utils/content";
import SectionHeader from "@/components/SectionHeader.astro";
import PostPreview from "./PostPreview.astro";
import { getAssetPath } from "@/utils/url";

type Props = {
  posts: Post[];
  sectionTitle?: string;
  sectionDesc?: string;
};

const {
  posts,
  sectionTitle,
  sectionDesc,
} = Astro.props;

---
<section>
  <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  <div class="flex flex-col space-y-4 mt-4">
    {posts.map((post) => (
      <PostPreview
        post={post}
        class="first:pt-0 border-b last:border-0 border-border/50"
        titleClass="text-base"
      />
    ))}
  </div>

  <a href={getAssetPath("/posts")} class="group inline-cta text-muted-foreground link-hover-muted">
    <span class="inline-cta-line group-hover:w-16 group-focus-visible:w-16" aria-hidden="true"></span>
    <span class="link-underline">All posts</span>
  </a>
</section>
