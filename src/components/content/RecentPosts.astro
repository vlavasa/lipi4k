---
import { type Post } from "@/utils/content";
import SectionHeader from "@/components/SectionHeader.astro";
import PostPreview from "./PostPreview.astro";
import { getAssetPath } from "@/utils/url";

type Props = {
  posts: Post[];
  sectionTitle?: string;
  sectionDesc?: string;
};

const {
  posts,
  sectionTitle,
  sectionDesc,
} = Astro.props;

---
<section class="my-2 md:my-4 py-4">
  <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  <div class="flex flex-col space-y-4 mt-4">
    {posts.map((post) => (
      <PostPreview
        post={post}
        class="first:pt-0 border-b last:border-0 border-border/50"
        titleClass="text-base"
      />
    ))}
  </div>

  <a href={getAssetPath("/posts")} class="group inline-cta text-muted-foreground hover:text-foreground">
    <span class="inline-cta-line group-hover:w-16"></span>
    All posts
  </a>
</section>
