---
import { type Post } from "@/utils/content";
import SectionHeader from "@/components/SectionHeader.astro";
import PostListItem from "@/components/content/PostListItem.astro";

type Props = {
  posts: Post[];
  sectionTitle?: string;
  sectionDesc?: string;
};

const {
  posts,
  sectionTitle,
  sectionDesc,
} = Astro.props;

---
<section class="related-posts mt-2 pt-2">
  <SectionHeader title={sectionTitle} subheading={sectionDesc} />
  <div class="flex flex-col space-y-2 mt-4">
    {posts.map((post) => (
      <PostListItem post={post} />
    ))}
  </div>
</section>

<style>
  /* Match the space below the previous/next article titles (mb-2 + mt-8). */
  :global(main:has(.related-posts) + footer) {
    margin-top: calc(var(--spacing) * 10);
  }
</style>
