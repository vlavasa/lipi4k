---
/**
 * PostGallery.astro
 *
 * Gallery section rendered at the end of a post in PostLayout.
 * Only rendered when the post has images in its gallery/ subdirectory.
 *
 * The shared gallery script in PostLayout handles GLightbox initialization.
 * The galleryId ties all images in this post to one lightbox group.
 *
 * Usage in PostLayout.astro:
 *   import { getGalleryImages } from '@/utils/image';
 *   import PostGallery from '@/components/content/PostGallery.astro';
 *
 *   const galleryImages = getGalleryImages(entry.filePath);
 *
 *   {galleryImages.length > 0 && (
 *     <PostGallery images={galleryImages} galleryId={entry.id} />
 *   )}
 */
import GalleryImage from '@/components/content/PostGalleryImage.astro';
import type { GalleryImage as GalleryImageType } from '@/utils/image';
import SectionHeader from '@/components/SectionHeader.astro';

interface Props {
  images: GalleryImageType[];
  galleryId: string;
  title?: string; // optional section heading override
}

const { images, galleryId, title = 'Gallery' } = Astro.props;
---

<section class="post-gallery" data-pagefind-ignore aria-label={title}>
  <div class="post-gallery__header flex items-baseline gap-3 mb-4">
    <SectionHeader title='Gallery' />
    <span class="post-gallery__count font-ui text-sm tabular-nums text-muted-foreground">{images.length} photo{images.length !== 1 ? 's' : ''}</span>
  </div>

  <div class="gallery-grid">
    {images.map((image) => (
      <GalleryImage image={image} galleryId={galleryId} />
    ))}
  </div>
</section>
