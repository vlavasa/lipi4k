---
import { type Post } from "@/utils/content";
import PostTitle from "./PostTitle.astro";
import PostMeta from "./PostMeta.astro";

type Props = {
  post: Post;
};

const { post } = Astro.props;
---

<div class="grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 py-1 first:pt-0 last:pb-0 text-muted-foreground">
  <PostTitle 
    post={post} 
    class="text-base md:text-lg font-medium text-balance leading-snug text-foreground 
    transition-colors duration-150 hover:text-primary ease-fluid"
  />

  <PostMeta post={post} showTags={false} class="text-right whitespace-nowrap" />
</div>
