---
import { getPostUrl, type Post } from "@/utils/content";
import { slugify } from "@/utils/text";
import PostMeta from "./PostMeta.astro";

type Props = {
  post: Post;
};

const { post } = Astro.props;
const titleSlug = slugify(post.data.title.replaceAll(".", "-"));
---

<a
  href={getPostUrl(post.id, post.filePath)}
  class="group grid grid-cols-[minmax(0,1fr)_auto] items-baseline gap-x-3 py-1 first:pt-0 last:pb-0 text-muted-foreground no-underline"
>
  <h2
    class="text-base md:text-lg font-medium text-balance leading-snug text-foreground link-underline
    transition-colors duration-150 group-hover:text-primary group-focus-visible:text-primary ease-fluid"
    transition:name={titleSlug}
  >
    {post.data.title}
  </h2>

  <PostMeta post={post} showTags={false} class="text-right whitespace-nowrap" />
</a>
