---
import type { Post } from "@/utils/content";
import { getPostMetadata } from "@/utils/post-meta";
import { slugify } from "@/utils/text";
import { getAssetPath } from "@/utils/url";

type Props = {
  post: Post;
  class?: string;
  activeTag?: string;
  showTags?: boolean;
};

const { post, class: className, activeTag, showTags = true } = Astro.props;
const { date, lang, displayDate, readingTime, readingTimeLang, tags } = getPostMetadata(post);
---
<div class:list={["metadata post-meta min-w-0", className]}>
  <time datetime={date.toISOString()} lang={lang} class="whitespace-nowrap tabular-nums">
    {displayDate}
  </time>
  {readingTime && <span lang={readingTimeLang} class="whitespace-nowrap">{readingTime}</span>}
  {showTags && tags.length > 0 && (
    <span class="wrap-anywhere">
      {tags.map((tag, index) => {
        const tagSlug = slugify(tag);
        return (
          <Fragment>
            {index > 0 && ", "}
            {tagSlug === activeTag ? (
              <span class="text-primary" aria-current="page">{tag}</span>
            ) : (
              <a
                href={getAssetPath(`/tags/${tagSlug}`)}
                class="hover:text-foreground focus-visible:text-foreground transition-colors"
              >{tag}</a>
            )}
          </Fragment>
        );
      })}
    </span>
  )}
</div>
