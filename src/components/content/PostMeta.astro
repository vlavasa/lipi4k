---
import { type Post } from "@/utils/content";
import { formatDate } from "@/utils/date";
import { calculateReadingTime } from "@/utils/text";
import siteConfig from "@/site.config";

type Props = {
  post: Post;
  class?: string;
  compact?: boolean;
  showReadingTime?: boolean;
  showLanguage?: boolean;
  accentCategory?: boolean;
};

const {
  post,
  class: className,
  compact = false,
  showReadingTime = false,
  showLanguage = false,
  accentCategory = false,
} = Astro.props;

const { category, published, updated, lang } = post.data;
const date = updated ?? published;
const dateLocale = lang ?? "en";

const displayDate = formatDate(date, dateLocale);

const readingTime =
  siteConfig.showReadingTime && showReadingTime
    ? calculateReadingTime(post.body ?? "").text
    : null;
---
<div
  class:list={[
    "metadata flex flex-row",
    compact ? "shrink-0 gap-3 text-right" : "post-meta items-baseline gap-2",
    className,
  ]}
>
  {
    category && (
      <span class:list={{ "text-primary": accentCategory }}>
        {category}
      </span>
    )
  }

  <time
    datetime={date.toISOString()}
    lang={dateLocale}
    class="tabular-nums"
  >
    {displayDate}
  </time>

  {
    readingTime && (
      <span>
        {readingTime}
      </span>
    )
  }

  {
    showLanguage && lang && (
      <span class="uppercase">
        {lang}
      </span>
    )
  }
</div>
