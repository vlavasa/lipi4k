---
import type { Post } from "@/utils/content";
import { getPostMetadata } from "@/utils/post-meta";
import { slugify } from "@/utils/text";
import { getAssetPath } from "@/utils/url";

type Props = {
  post: Post;
  class?: string;
  activeTag?: string;
};

const { post, class: className, activeTag } = Astro.props;
const { date, lang, displayDate, readingTime, tags } = getPostMetadata(post);
---
<div class:list={["metadata post-meta min-w-0", className]}>
  <time datetime={date.toISOString()} lang={lang} class="whitespace-nowrap tabular-nums">
    {displayDate}
  </time>
  {readingTime && <span class="whitespace-nowrap">{readingTime}</span>}
  {tags.length > 0 && (
    <span class="wrap-anywhere">
      {tags.map((tag, index) => (
        <Fragment>
          {index > 0 && ", "}
          <a
            href={getAssetPath(`/tags/${slugify(tag)}`)}
            class:list={[
              "hover:underline focus-visible:underline underline-offset-2",
              { "text-primary": slugify(tag) === activeTag },
            ]}
            aria-current={slugify(tag) === activeTag ? "page" : undefined}
          >{tag}</a>
        </Fragment>
      ))}
    </span>
  )}
</div>
