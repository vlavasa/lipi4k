---
import SearchIcon from "@/assets/search.svg";
import { getAssetPath } from "@/utils/url";
---

<site-search
  data-base-url={getAssetPath("/")}
  data-dev={import.meta.env.DEV}
  data-pagefind-ignore
>
  <dialog
    id="site-search-dialog"
    class="search-dialog"
    aria-labelledby="search-title"
  >
    <h2 id="search-title" class="sr-only">Search this site</h2>
    <form class="search-form" role="search">
      <div class="search-field">
        <label for="search-input" class="sr-only"
          >Search articles and pages</label
        >
        <SearchIcon
          width="20"
          height="20"
          class="search-field-icon"
          aria-hidden="true"
        />
        <input
          id="search-input"
          type="search"
          placeholder="Search articles and pages…"
          autocomplete="off"
          spellcheck="false"
          enterkeyhint="search"
          aria-controls="search-results"
        />
        <button type="button" class="search-clear" data-search-clear hidden
          >Clear</button
        >
      </div>
      <button
        type="button"
        class="search-close"
        data-search-close
        aria-label="Close search"
        title="Close (Esc)"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="m6 6 12 12M6 18 18 6"></path>
        </svg>
      </button>
    </form>
    <div class="search-body">
      <p
        class="search-status"
        role="status"
        aria-live="polite"
        aria-atomic="true"
        data-search-status
      >
        Type to search articles and pages.
      </p>
      <ol
        id="search-results"
        class="search-results"
        aria-label="Search results"
        hidden
      >
      </ol>
      <button type="button" class="search-more" data-search-more hidden
        >Load more results</button
      >
      <button type="button" class="search-more" data-search-retry hidden
        >Try again</button
      >
    </div>
    <div class="search-footer" aria-hidden="true">
      <span><kbd>↑</kbd> <kbd>↓</kbd> to navigate</span>
      <span><kbd>Esc</kbd> to close</span>
    </div>
  </dialog>
</site-search>

<script>
  import "@/scripts/search";
</script>
