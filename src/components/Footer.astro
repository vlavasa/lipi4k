---
import siteConfig from "@/site.config";
import { renderFooterNote } from "@/utils/footer-note";
import { getAssetPath, isActiveNavUrl } from "@/utils/url";

const annotation = siteConfig.annotation?.trim();
const note = await renderFooterNote(siteConfig.footerNote);
---

<footer class="border-border mt-10 border-t py-8" data-pagefind-ignore>
  <div class="app-layout">
    <div class="flex flex-col items-center">
      <span class="block text-xl font-semibold tracking-tight">
        {siteConfig.author}<span class="text-primary font-normal">.</span>
      </span>
      {siteConfig.footerLinks.length > 0 && (
        <nav aria-label="Footer" class="mt-2">
          <ul class="flex flex-wrap items-center justify-center gap-x-6 font-ui text-sm text-muted-foreground">
            {siteConfig.footerLinks.map((item) => {
              const active = isActiveNavUrl(item.url, Astro.url.pathname);
              const Tag = active ? "span" : "a";
              return (
                <li>
                  <Tag
                    href={active ? undefined : getAssetPath(item.url)}
                    class="footer-nav-link"
                    aria-current={active ? "page" : undefined}
                  >
                    {item.title}
                  </Tag>
                </li>
              );
            })}
          </ul>
        </nav>
      )}
      {annotation && (
        <span class="font-annotation block text-primary max-w-70 md:max-w-80 mx-auto mt-6 text-xl md:text-2xl text-center -rotate-1 leading-snug">
          {annotation}
        </span>
      )}
      {note && (
        <div class="footer-note font-code mt-6 max-w-xl text-xs text-muted-foreground text-center text-balance leading-relaxed" set:html={note} />
      )}
    </div>
  </div>
</footer>

<style>
  .footer-note {
    overflow-wrap: anywhere;
  }

  .footer-note :global(p + p) {
    margin-top: 0.5em;
  }
</style>
